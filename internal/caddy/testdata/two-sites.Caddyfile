# Generated by Benbow. Do not edit: changes are overwritten.
{
	admin "unix//Users/test/Library/Application Support/benbow/run/caddy-admin.sock"
	persist_config off
	https_port 8443
	default_bind 127.0.0.1 [::1]
	auto_https disable_redirects
	skip_install_trust
	storage file_system "/Users/test/Library/Application Support/benbow/data/caddy"
	pki {
		ca local {
			name "Benbow Local CA"
			root {
				format pem_file
				cert "/Users/test/Library/Application Support/benbow/data/ca/root.crt"
			}
			intermediate {
				format pem_file
				cert "/Users/test/Library/Application Support/benbow/data/ca/intermediate.crt"
				key "/Users/test/Library/Application Support/benbow/data/ca/intermediate.key"
			}
		}
	}
	log {
		output file "/Users/test/Library/Application Support/benbow/logs/caddy.log" {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# site: demo
"https://demo.localhost:8443", "https://shop.test:8443", "https://www.demo.localhost:8443" {
	tls internal
	log {
		output file "/Users/test/Library/Application Support/benbow/logs/sites/demo/access.log" {
			roll_size 5MiB
			roll_keep 2
		}
	}
	root * "/Users/test/Sites/My Demo"
	@benbowprobe header_regexp benbowprobe X-Benbow-Probe ^[0-9a-f]{32}$
	php_fastcgi @benbowprobe "unix//Users/test/Library/Application Support/benbow/run/php84.sock" {
		env PHP_VALUE "memory_limit=1G
display_errors=Off
error_log=/Users/test/Library/Application Support/benbow/tmp/probes/{http.request.header.X-Benbow-Probe}.log"
	}
	php_fastcgi "unix//Users/test/Library/Application Support/benbow/run/php84.sock" {
		env PHP_VALUE "memory_limit=1G
display_errors=Off
error_log=/Users/test/Library/Application Support/benbow/logs/sites/demo/php-error.log"
	}
	file_server
}

# site: legacy
"https://legacy.localhost:8443" {
	tls internal
	root * "/Users/test/Sites/legacy"
	php_fastcgi "unix//Users/test/Library/Application Support/benbow/run/php82.sock"
	file_server
}

# adminer
"https://adminer.localhost:8443" {
	tls internal
	root * "/Users/test/Library/Application Support/benbow/components/adminer/6.2.0-all"
	rewrite * /index.php
	php_fastcgi "unix//Users/test/Library/Application Support/benbow/run/php84.sock"
}

# http → https
"http://:8080" {
	redir "https://{host}{uri}" 308
}

# phone: demo
"https://demo-mac.local:9443" {
	bind 192.168.1.5 10.0.0.2
	tls internal
	# The network sees this site: never its dotfiles (.git, .env), dumps,
	# backups or logs.
	@benbowhidden {
		path */.* *.sql *.sql.gz *.bak *.log *.zip *.tar.gz
		not path /.well-known/*
	}
	respond @benbowhidden 404
	header >Location "https://demo.localhost" "https://demo-mac.local:9443"
	root * "/Users/test/Sites/My Demo"
	php_fastcgi "unix//Users/test/Library/Application Support/benbow/run/php84.sock" {
		env PHP_VALUE "memory_limit=1G
auto_prepend_file=/Users/test/Library/Application Support/benbow/data/phone/prepend.php"
		env BENBOW_PHONE_URL "https://demo-mac.local:9443"
		env BENBOW_LOCAL_URL "https://demo.localhost"
	}
	file_server
}
