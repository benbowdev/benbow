# Generated by Covo. Do not edit: changes are overwritten.
{
	admin "unix//Users/test/Library/Application Support/covo/run/caddy-admin.sock"
	persist_config off
	https_port 8443
	default_bind 127.0.0.1 [::1]
	auto_https disable_redirects
	skip_install_trust
	storage file_system "/Users/test/Library/Application Support/covo/data/caddy"
	pki {
		ca local {
			name "Covo Local CA"
			root {
				format pem_file
				cert "/Users/test/Library/Application Support/covo/data/ca/root.crt"
			}
			intermediate {
				format pem_file
				cert "/Users/test/Library/Application Support/covo/data/ca/intermediate.crt"
				key "/Users/test/Library/Application Support/covo/data/ca/intermediate.key"
			}
		}
	}
	log {
		output file "/Users/test/Library/Application Support/covo/logs/caddy.log" {
			roll_size 10MiB
			roll_keep 3
		}
	}
}

# site: shop
"https://shop.localhost:8443", "https://www.shop.localhost:8443" {
	tls internal
	log {
		output file "/Users/test/Library/Application Support/covo/logs/sites/shop/access.log" {
			roll_size 5MiB
			roll_keep 2
		}
	}
	reverse_proxy localhost:41000
}

# site: api
"https://api.covo.test:8443" {
	tls internal
	reverse_proxy localhost:3000 {
		header_up Host localhost:3000
	}
}

# phone: shop
"https://shop-mac.local:9443" {
	bind 192.168.1.5
	tls internal
	# The network sees this site: never its dotfiles (.git, .env), dumps,
	# backups or logs.
	@covohidden {
		path */.* *.sql *.sql.gz *.bak *.log *.zip *.tar.gz
		not path /.well-known/*
		# Vite's pre-bundled dependencies.
		not path /node_modules/.vite/*
	}
	respond @covohidden 404
	header >Location "https://shop.localhost:8443" "https://shop-mac.local:9443"
	reverse_proxy localhost:41000
}
"http://:9444" {
	bind 192.168.1.5
	root * "/Users/test/Library/Application Support/covo/data/phone/ca"
	header /covo-ca.mobileconfig Content-Type application/x-apple-aspen-config
	header /covo-ca.crt Content-Type application/x-x509-ca-cert
	file_server
}
